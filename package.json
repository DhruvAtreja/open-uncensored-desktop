{
  "name": "open-uncensored-desktop",
  "productName": "OpenUncensored",
  "version": "0.1.10",
  "description": "Chat and a coding agent on uncensored models, from OpenUncensored.",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@openai/codex": "0.163.0",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.openuncensored.desktop",
    "productName": "OpenUncensored",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "!electron/devdrive.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@openai/codex-darwin-*/**",
      "electron/image-tool.cjs"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "OpenUncensored"
    },
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "artifactName": "OpenUncensored-${version}-mac-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DhruvAtreja/open-uncensored-desktop"
  },
  "homepage": "https://openuncensored.com",
  "author": "Dhruv Atreja"
}
